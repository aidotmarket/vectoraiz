  {
    "name": "search",
    "description": "Search passages in the library.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "collection": {
          "type": "string",
          "enum": [
            "library"
          ]
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 8
        }
      },
      "required": [
        "query"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "hits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chunk_id": {
                "type": "string"
              },
              "doc_id": {
                "type": "string"
              },
              "file_name": {
                "type": "string"
              },
              "page": {
                "type": "integer"
              },
              "text": {
                "type": "string"
              },
              "score": {
                "type": "number"
              }
            },
            "required": [
              "chunk_id",
              "doc_id",
              "file_name",
              "page",
              "text",
              "score"
            ]
          }
        }
      },
      "required": [
        "hits"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
