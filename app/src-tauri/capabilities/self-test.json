{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "self-test",
  "description": "Local main window diagnostic and indexing, search, chat and consented update commands only.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-self-test",
    "allow-pipeline-index",
    "allow-pipeline-search",
    "allow-pipeline-ask",
    "allow-update-check",
    "allow-update-install",
    "allow-models-status",
    "allow-models-download",
    "allow-models-cancel",
    "allow-models-import",
    "allow-answer-add",
    "allow-answer-switch",
    "allow-answer-turn-off",
    "allow-delete-unused-model",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-cloud-status",
    "allow-api-key-disclosure",
    "allow-api-key-confirm",
    "allow-api-key-set",
    "allow-api-key-stop",
    "allow-api-key-cleanup-retry",
    "allow-answer-path-set"
  ]
}
